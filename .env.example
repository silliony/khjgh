# ==============================================================================
# SEGURANÇA DE CHAVES & VARIÁVEIS DE AMBIENTE
# IMPORTANTE: NUNCA comite arquivos .env ou chaves secretas reais no GitHub!
# Mantenha suas credenciais seguras. No GitHub Actions ou GitHub Pages, utilize
# "Repository Secrets" ou "Environment Variables" nas configurações do repositório.
# ==============================================================================

# Backend / Servidor (Segredo estrito - NUNCA exposto ao navegador)
# Chave da API do Google Gemini (utilizada exclusivamente pelo backend em server.ts)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde o applet está hospedado (Cloud Run / AI Studio)
APP_URL="MY_APP_URL"

# ==============================================================================
# FIREBASE (Frontend / Client-side)
# Variáveis opcionais com prefixo VITE_ para configurar ou sobrescrever o Firebase
# no GitHub Pages ou em ambientes de CI/CD sem comitar arquivos locais.
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# ==============================================================================
# GITHUB PAGES / ROTEAMENTO
# Caminho base relativo. O padrão "./" permite funcionamento em qualquer
# subdiretório do GitHub Pages (ex: https://usuario.github.io/nome-do-repositorio/)
# ==============================================================================
VITE_BASE_PATH="./"
