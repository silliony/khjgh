{
  "entities": {
    "User": {
      "path": "users/{userId}",
      "description": "Perfil e configurações financeiras de cada usuário",
      "fields": {
        "uid": { "type": "string", "description": "ID do usuário no Firebase Auth" },
        "email": { "type": "string", "description": "Email do usuário" },
        "displayName": { "type": "string", "description": "Nome de exibição" },
        "monthlyIncome": { "type": "number", "description": "Renda mensal base em R$" },
        "totalReserve": { "type": "number", "description": "Reserva total acumulada em R$" },
        "reserveTargetMonths": { "type": "number", "description": "Meta em meses de reserva de emergência" },
        "createdAt": { "type": "string", "description": "Data de criação ISO" },
        "updatedAt": { "type": "string", "description": "Última atualização ISO" }
      }
    },
    "Transaction": {
      "path": "users/{userId}/transactions/{transactionId}",
      "description": "Lançamentos financeiros (receitas e despesas) do usuário",
      "fields": {
        "id": { "type": "string", "description": "ID do lançamento" },
        "description": { "type": "string", "description": "Descrição da transação" },
        "amount": { "type": "number", "description": "Valor em R$" },
        "date": { "type": "string", "description": "Data YYYY-MM-DD" },
        "type": { "type": "string", "description": "expense ou income" },
        "categoryId": { "type": "string", "description": "ID da categoria" },
        "subcategory": { "type": "string", "description": "Subcategoria opcional" },
        "nature": { "type": "string", "description": "need, want ou savings (regra 50/30/20)" },
        "isSubscription": { "type": "boolean", "description": "Flag indicando assinatura recorrente" },
        "subscriptionName": { "type": "string", "description": "Nome do serviço de assinatura" },
        "notes": { "type": "string", "description": "Observações adicionais" },
        "paymentMethod": { "type": "string", "description": "Método de pagamento" },
        "createdAt": { "type": "string", "description": "Data de criação ISO" },
        "updatedAt": { "type": "string", "description": "Data de atualização ISO" }
      }
    },
    "Category": {
      "path": "users/{userId}/categories/{categoryId}",
      "description": "Categorias personalizadas de gastos do usuário",
      "fields": {
        "id": { "type": "string", "description": "Identificador da categoria" },
        "name": { "type": "string", "description": "Nome da categoria" },
        "iconName": { "type": "string", "description": "Nome do ícone" },
        "color": { "type": "string", "description": "Cor hexadecimal" },
        "nature": { "type": "string", "description": "need, want ou savings" },
        "defaultPct": { "type": "number", "description": "Percentual sugerido" },
        "description": { "type": "string", "description": "Descrição" }
      }
    },
    "Budget": {
      "path": "users/{userId}/budgets/{categoryId}",
      "description": "Orçamento definido por categoria",
      "fields": {
        "categoryId": { "type": "string", "description": "ID da categoria" },
        "reservedAmount": { "type": "number", "description": "Valor orçado em R$" }
      }
    },
    "RecurringIncome": {
      "path": "users/{userId}/recurringIncomes/{sourceId}",
      "description": "Fontes de renda recorrentes configuradas",
      "fields": {
        "id": { "type": "string", "description": "ID da fonte" },
        "name": { "type": "string", "description": "Nome da fonte de renda" },
        "amount": { "type": "number", "description": "Valor base em R$" },
        "dayOfMonth": { "type": "number", "description": "Dia do mês ou padrão" },
        "paydayType": { "type": "string", "description": "Tipo de pagamento" },
        "isWorkingDaysVA": { "type": "boolean", "description": "Se é benefício calculado por dias úteis" },
        "dailyRate": { "type": "number", "description": "Valor diário" },
        "manualWorkingDaysOverride": { "type": "number", "description": "Sobrescrita de dias úteis" },
        "notes": { "type": "string", "description": "Notas" }
      }
    }
  }
}
